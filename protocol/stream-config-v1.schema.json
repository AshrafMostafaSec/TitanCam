{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TitanCam development effective stream configuration",
  "type": "object",
  "required": [
    "config_id",
    "profile",
    "width",
    "height",
    "fps",
    "bitrate",
    "codec",
    "audio_codec",
    "audio_channels",
    "audio_packet_ms",
    "playout_ms"
  ],
  "properties": {
    "config_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "profile": {
      "enum": [
        "saver",
        "balanced",
        "maximum"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2160
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "bitrate": {
      "type": "integer",
      "minimum": 100000,
      "maximum": 100000000
    },
    "codec": {
      "enum": [
        "h264",
        "hevc"
      ]
    },
    "audio_codec": {
      "enum": [
        "pcm",
        "opus"
      ]
    },
    "audio_channels": {
      "enum": [
        1,
        2
      ]
    },
    "audio_packet_ms": {
      "enum": [
        5,
        10,
        20
      ]
    },
    "playout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "camera_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "audio_input_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "audio_data_source": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "wifi_budget_mbps": {
      "type": "integer",
      "minimum": 5,
      "maximum": 200,
      "default": 35
    }
  },
  "additionalProperties": true
}
